# Copy this file to .env and fill in the values.
# Everything here should point at a DEVELOPMENT database. Production values go in Vercel only.

# --- Payload ---
# Payload reads DATABASE_URI. Use the Supabase session pooler, port 5432:
# transaction mode (6543) drops prepared statements, which Payload's Drizzle adapter uses.
# If it ever fails with a prepared-statement error, switch to the transaction pooler on
# 6543 and add ?pgbouncer=true (see spec §6) and record which one you used.
DATABASE_URI=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# The dev Supabase project ref (the "postgres.XXXX" part of DATABASE_URI's username above).
# Four scripts refuse to run unless DATABASE_URI's project ref matches this value — seed.ts,
# export-order.ts, erase-order.ts and prune-orders.ts — so each can positively confirm it is
# targeting development, not production. Three of them read, redact or delete customer data.
SEED_DEV_PROJECT_REF=PROJECT

# Any long random string. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# --- Media ---
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# --- Stripe (sandbox / test mode only) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- URLs ---
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Required by scripts/seed.ts. At least 16 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SEED_ADMIN_PASSWORD=

# --- Overrides: leave unset ---
# ORDER_ADMIN_ALLOW_UNSAFE=1 switches off the project-ref check above for export-order.ts,
# erase-order.ts and prune-orders.ts — the scripts that export, redact and delete customer
# orders. It exists for a human pointing those scripts at a non-development database on
# purpose. Do not put a value here: an override sitting in a committed-shaped file is an
# override nobody remembers is on. See README's Known limitations for what still guards
# after it, and how little.
# ORDER_ADMIN_ALLOW_UNSAFE=
